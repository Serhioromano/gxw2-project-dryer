CASE giProbeType OF
	0: giPID_T_PV := (AI_Temp1 + AI_Temp2) / 2;
	1: giPID_T_PV := AI_Temp1;
	2: giPID_T_PV := AI_Temp2;
END_CASE;

AI_Temp1 := R23700;
AI_Temp2 := R23701;
AI_Temp3 := R23702;
AI_Temp4 := R23703;
AI_TempProd1 := R23704;
AI_TempProd2 := R23705;
AI_TempProd3 := R23706;
AI_Pressure := F_SCALE(R23708, 0, 32000, 0, -1000);
AI_PVTHumid := F_SCALE(R23709, 0, 32000, 50, 950);
AI_PVTTempr := F_SCALE(R23710, 0, 32000, -400, 800);
AI_AirFlow := F_SCALE(R23711, 0, 32000, 0, 1000);

AI_Valve1Position := F_SCALE(D8032, 0, 4090, 0, 100);
AI_Valve2Position := F_SCALE(D8033, 0, 4090, 0, 100);

fT1 := F_FLT10(AI_Temp1);	
fT2 := F_FLT10(AI_Temp2);	
fT3 := F_FLT10(AI_Temp3);	
fT4 := F_FLT10(AI_Temp4);
fTAvg := (fT1 + fT2 + fT3 + fT4) / 4.0;

fP1 := F_FLT10(AI_TempProd1);	
fP2 := F_FLT10(AI_TempProd2);	
fP3 := F_FLT10(AI_TempProd3);	
fpAvg := (fP1 + fP2 + fP3) / 3.0;

fPress := F_FLT10(AI_Pressure);	
fT100 := F_FLT10(AI_PVTTempr);	
fH100 := F_FLT10(AI_PVTHumid);	
fFlow := F_FLT10(AI_AirFlow);	

giPID_H_PV := AI_PVTHumid;

IF gxManualMode THEN
	(* Ручной режим: положение клапанов задаётся с панели (0-100%) *)
	AO_Valve1 := F_SCALE(giValve1Pos, 0, 100, 0, 4090);
	AO_Valve2 := F_SCALE(giValve2Pos, 0, 100, 0, 4090);
ELSE
	(* Процесс: клапаны управляются ПИД температуры *)
	AO_Valve1 := giPID_T_MV;
	AO_Valve2 := giPID_T_MV;
END_IF;

(* Отображение состояния и положения клапанов (задвижек) на HMI *)
gxValve1Work := AO_Valve1 > 0;
gxValve2Work := AO_Valve2 > 0;


fbAmSet(iNum := 0, xState := DI_VFDAlarm1);
fbAmSet(iNum := 1, xState := DI_VFDAlarm2);
fbAmSet(iNum := 2, xState := DI_VFDAlarm3);
fbAmSet(iNum := 3, xState := DI_VFDAlarm4);
fbAmSet(iNum := 4, xState := DI_VFDAlarm5);
fbAmSet(iNum := 5, xState := DI_VFDAlarm6);
fbAmSet(iNum := 6, xState := DI_VFDAlarm7);
fbAmSet(iNum := 7, xState := DI_VFDAlarm8);
fbAmSet(iNum := 8, xState := DI_VFDAlarm9);
fbAmSet(iNum := 9, xState := DI_VFDAlarm10);
fbAmSet(iNum := 10, xState := DI_VFDAlarm11);
fbAmSet(iNum := 11, xState := DI_VFDAlarm12);
fbAmSet(iNum := 12, xState := DI_VFDAlarm13);
fbAmSet(iNum := 13, xState := DI_VFDAlarm14);
fbAmSet(iNum := 14, xState := DI_VFDAlarmHumid);

(* Обрыв датчиков температуры *)
fbAmSet(iNum := 15, xState := R23700 = -1900); (* Воздух 1 *)
fbAmSet(iNum := 16, xState := R23701 = -1900); (* Воздух 2 *)
fbAmSet(iNum := 17, xState := R23702 = -1900); (* Воздух 3 *)
fbAmSet(iNum := 18, xState := R23703 = -1900); (* Воздух 4 *)
fbAmSet(iNum := 19, xState := R23704 = -1900); (* Продукт 1 *)
fbAmSet(iNum := 20, xState := R23705 = -1900); (* Продукт 2 *)
fbAmSet(iNum := 21, xState := R23706 = -1900); (* Продукт 3 *)
fbAmSet(iNum := 22, xState := D8032 = 32760); (* Положение задвижки ПАР 1 *)
fbAmSet(iNum := 23, xState := D8033 = 32760); (* Положение задвижки ПАР 2 *)

fbAmReset(IN := gxAlarmReset, AutoReset := 60);
fbAMPack(DNUM := 3000, PD := c_AM_PACK_M);

(* Наличие любой аварии (любой процесс/важность) — для HMI *)
fbAmHas(iProcessNum := 0, iSeverity := 0, Q := gxHasAlarm);

DO_VFDReset := gxAlarmReset 
	AND (
		DI_VFDAlarm1
		OR DI_VFDAlarm2
		OR DI_VFDAlarm3
		OR DI_VFDAlarm4
		OR DI_VFDAlarm5
		OR DI_VFDAlarm6
		OR DI_VFDAlarm7
		OR DI_VFDAlarm8
		OR DI_VFDAlarm9
		OR DI_VFDAlarm10
		OR DI_VFDAlarm11
		OR DI_VFDAlarm12
		OR DI_VFDAlarm13
		OR DI_VFDAlarm14
		OR DI_VFDAlarmHumid
	);

iVFDProcessSpeed := F_SCALE(giCSVFDSpeed, 0, 100, 0, 32000);

AO_VFD1 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD1Speed, 0, 500, 0, 32000));
DO_VFD1 := ((gxManualMode AND gxVFD1) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm1 AND (AO_VFD1 > 0);

AO_VFD2 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD2Speed, 0, 500, 0, 32000));
DO_VFD2 := ((gxManualMode AND gxVFD2) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm2 AND (AO_VFD2 > 0);

AO_VFD3 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD3Speed, 0, 500, 0, 32000));
DO_VFD3 := ((gxManualMode AND gxVFD3) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm3 AND (AO_VFD3 > 0);

AO_VFD4 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD4Speed, 0, 500, 0, 32000));
DO_VFD4 := ((gxManualMode AND gxVFD4) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm4 AND (AO_VFD4 > 0);

AO_VFD5 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD5Speed, 0, 500, 0, 32000));
DO_VFD5 := ((gxManualMode AND gxVFD5) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm5 AND (AO_VFD5 > 0);

AO_VFD6 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD6Speed, 0, 500, 0, 32000));
DO_VFD6 := ((gxManualMode AND gxVFD6) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm6 AND (AO_VFD6 > 0);

AO_VFD7 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD7Speed, 0, 500, 0, 32000));
DO_VFD7 := ((gxManualMode AND gxVFD7) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm7 AND (AO_VFD7 > 0);

AO_VFD8 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD8Speed, 0, 500, 0, 32000));
DO_VFD8 := ((gxManualMode AND gxVFD8) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm8 AND (AO_VFD8 > 0);

AO_VFD9 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD9Speed, 0, 500, 0, 32000));
DO_VFD9 := ((gxManualMode AND gxVFD9) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm9 AND (AO_VFD9 > 0);

AO_VFD10 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD10Speed, 0, 500, 0, 32000));
DO_VFD10 := ((gxManualMode AND gxVFD10) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm10 AND (AO_VFD10 > 0);

AO_VFD11 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD11Speed, 0, 500, 0, 32000));
DO_VFD11 := ((gxManualMode AND gxVFD11) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm11 AND (AO_VFD11 > 0);

AO_VFD12 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD12Speed, 0, 500, 0, 32000));
DO_VFD12 := ((gxManualMode AND gxVFD12) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm12 AND (AO_VFD12 > 0);

AO_VFD13 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD13Speed, 0, 500, 0, 32000));
DO_VFD13 := ((gxManualMode AND gxVFD13) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm13 AND (AO_VFD13 > 0);

AO_VFD14 := SEL(gxManualMode, iVFDProcessSpeed, F_SCALE(giVFD14Speed, 0, 500, 0, 32000));
DO_VFD14 := ((gxManualMode AND gxVFD14) OR (NOT gxManualMode AND gxFansRun)) AND NOT DI_VFDAlarm14 AND (AO_VFD14 > 0);


IF gxManualMode THEN
	AO_VFDVent := F_SCALE(giVFDVentSpeed, 0, 500, 0, 32000);
ELSE
	AO_VFDVent := giPID_H_MV;
	(* Если нужно ограничивать, и есть значение приводим его к минимальному. *)
	LIMITATION_E(griMinVentSpeed > 0 AND giPID_H_MV > 0, F_SCALE(griMinVentSpeed, 0, 100, 0, 32000), giPID_H_MV, 32000, AO_VFDVent);
END_IF;
DO_VFDHum := ((gxManualMode AND gxVFDVent) OR (NOT gxManualMode)) AND NOT DI_VFDAlarmHumid AND (AO_VFDVent > 0);


giCS_NumDisplay := SEL(gxProgress, 0, giCS_Num + 1);

(* Остаток времени текущего этапа в минутах (для HMI) *)
giRaiseMinLeft := LIMITATION(0, giCSRaiseTime - giCS_RaiseETime, giCSRaiseTime);
giHoldMinLeft := LIMITATION(0, giCSHoldTime - giCS_HoldETime, giCSHoldTime);

(* Состояния ПЧ: 0-не активирован, 1-не работает, 2-работает, 3-ошибка *)

IF DI_VFDAlarm1 THEN
	giVFD1State := c_VFD_ST_FAULT;
ELSIF DO_VFD1 THEN
	giVFD1State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD1) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD1State := c_VFD_ST_STOPPED;
ELSE
	giVFD1State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm2 THEN
	giVFD2State := c_VFD_ST_FAULT;
ELSIF DO_VFD2 THEN
	giVFD2State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD2) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD2State := c_VFD_ST_STOPPED;
ELSE
	giVFD2State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm3 THEN
	giVFD3State := c_VFD_ST_FAULT;
ELSIF DO_VFD3 THEN
	giVFD3State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD3) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD3State := c_VFD_ST_STOPPED;
ELSE
	giVFD3State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm4 THEN
	giVFD4State := c_VFD_ST_FAULT;
ELSIF DO_VFD4 THEN
	giVFD4State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD4) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD4State := c_VFD_ST_STOPPED;
ELSE
	giVFD4State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm5 THEN
	giVFD5State := c_VFD_ST_FAULT;
ELSIF DO_VFD5 THEN
	giVFD5State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD5) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD5State := c_VFD_ST_STOPPED;
ELSE
	giVFD5State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm6 THEN
	giVFD6State := c_VFD_ST_FAULT;
ELSIF DO_VFD6 THEN
	giVFD6State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD6) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD6State := c_VFD_ST_STOPPED;
ELSE
	giVFD6State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm7 THEN
	giVFD7State := c_VFD_ST_FAULT;
ELSIF DO_VFD7 THEN
	giVFD7State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD7) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD7State := c_VFD_ST_STOPPED;
ELSE
	giVFD7State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm8 THEN
	giVFD8State := c_VFD_ST_FAULT;
ELSIF DO_VFD8 THEN
	giVFD8State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD8) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD8State := c_VFD_ST_STOPPED;
ELSE
	giVFD8State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm9 THEN
	giVFD9State := c_VFD_ST_FAULT;
ELSIF DO_VFD9 THEN
	giVFD9State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD9) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD9State := c_VFD_ST_STOPPED;
ELSE
	giVFD9State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm10 THEN
	giVFD10State := c_VFD_ST_FAULT;
ELSIF DO_VFD10 THEN
	giVFD10State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD10) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD10State := c_VFD_ST_STOPPED;
ELSE
	giVFD10State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm11 THEN
	giVFD11State := c_VFD_ST_FAULT;
ELSIF DO_VFD11 THEN
	giVFD11State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD11) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD11State := c_VFD_ST_STOPPED;
ELSE
	giVFD11State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm12 THEN
	giVFD12State := c_VFD_ST_FAULT;
ELSIF DO_VFD12 THEN
	giVFD12State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD12) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD12State := c_VFD_ST_STOPPED;
ELSE
	giVFD12State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm13 THEN
	giVFD13State := c_VFD_ST_FAULT;
ELSIF DO_VFD13 THEN
	giVFD13State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD13) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD13State := c_VFD_ST_STOPPED;
ELSE
	giVFD13State := c_VFD_ST_NOT_ACTIVE;
END_IF;

IF DI_VFDAlarm14 THEN
	giVFD14State := c_VFD_ST_FAULT;
ELSIF DO_VFD14 THEN
	giVFD14State := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFD14) OR (NOT gxManualMode AND gxProgress) THEN
	giVFD14State := c_VFD_ST_STOPPED;
ELSE
	giVFD14State := c_VFD_ST_NOT_ACTIVE;
END_IF;

(* ПЧ вентиляции/увлажнения *)
IF DI_VFDAlarmHumid THEN
	giVFDVentState := c_VFD_ST_FAULT;
ELSIF DO_VFDHum THEN
	giVFDVentState := c_VFD_ST_RUNNING;
ELSIF (gxManualMode AND gxVFDVent) OR (NOT gxManualMode AND gxProgress) THEN
	giVFDVentState := c_VFD_ST_STOPPED;
ELSE
	giVFDVentState := c_VFD_ST_NOT_ACTIVE;
END_IF;
