(* Init PID *) (* Настройка параметров ПИД регулирования *)
R500 := 1000; (* Time 1c *)
R501 := 2#0000_0000_0000_0001; (* Heating mode *)
R522 := 4090; (* Output max 100% *)
R523 := 0; (* Output min *)
R525 := 10; (* Delta for Autotune 1.0 C *)
R526 := R522; (* Autotune output upper value *)
R527 := 0; (* Autotune output lower value *)

(* Init PIDHum *) (* Настройка параметров ПИД регулирования *)
R600 := 1000; (* Time 1c *)
R601 := 2#0000_0000_0000_0000; (* Cooling mode *)
R622 := 32000; (* Output max 100% *)
R623 := 0; (* Output min *)
R625 := 10; (* Delta for Autotune 1.0 C *)
R626 := R622; (* Autotune output upper value *)
R627 := 0; (* Autotune output lower value *)

(* Инициализация аварий AlarmManager: 15 ошибок ПЧ (iNum 0..14) *)
fbAmInit(iNum := 0, iSeverity := 0, iProcess := 0, 
    iDelay := 0, xLatch := FALSE, xAutoReset := FALSE, 
    xBuzzer := FALSE, xLock := FALSE);
fbAmInit(iNum := 1);
fbAmInit(iNum := 2);
fbAmInit(iNum := 3);
fbAmInit(iNum := 4);
fbAmInit(iNum := 5);
fbAmInit(iNum := 6);
fbAmInit(iNum := 7);
fbAmInit(iNum := 8);
fbAmInit(iNum := 9);
fbAmInit(iNum := 10);
fbAmInit(iNum := 11);
fbAmInit(iNum := 12);
fbAmInit(iNum := 13);
fbAmInit(iNum := 14);

(* обрывы датчиков *)
fbAmInit(iNum := 15);
fbAmInit(iNum := 16);
fbAmInit(iNum := 17);
